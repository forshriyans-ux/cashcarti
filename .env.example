# Local deterministic demo only. Copy to .env; replace the token with a random secret.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DEMO_MODE=true
DEMO_TOKEN=replace-with-a-random-secret-at-least-32-characters
# Leave DATABASE_URL unset for single-process persistent embedded PostgreSQL (PGlite).
# Use docker compose up -d db, then uncomment for ordinary PostgreSQL:
# DATABASE_URL=postgresql://permitproof:local-development-only@127.0.0.1:5432/permitproof
PGLITE_PATH=./data/database
STORAGE_DRIVER=local
STORAGE_PATH=./data/private
MAX_UPLOAD_MB=25
MAX_PAGES=60
MAX_PROJECT_DOCUMENTS=20
RETENTION_DAYS=90
OCR_ENABLED=true
CLAMAV_ENABLED=false
WORKER_ENABLED=true
# Set to the actual existing frontend origin when it becomes available.
# CORS_ORIGIN=http://localhost:5173

# Production: NODE_ENV=production, DEMO_MODE=false, DATABASE_URL required.
# OIDC_ISSUER=https://identity.example.com/
# OIDC_AUDIENCE=permitproof-api
# OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Provision known identities using the trusted bootstrap CLI; never trust client org claims.
# BOOTSTRAP_SUBJECT=your-issuer-subject
# BOOTSTRAP_EMAIL=admin@example.com
# BOOTSTRAP_ORGANIZATION=Your organization
# BOOTSTRAP_RULE_ADMIN=true

# Optional private object storage (standard AWS credential chain; no public ACLs).
# STORAGE_DRIVER=s3
# S3_BUCKET=your-private-bucket
# S3_REGION=us-west-2
# S3_ENDPOINT=https://your-s3-compatible-endpoint
# AWS_ACCESS_KEY_ID=server-side-only
# AWS_SECRET_ACCESS_KEY=server-side-only

# AI remains optional. No model API calls occur unless explicitly enabled.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
# AI_API_KEY=server-side-only
AI_DAILY_CALL_LIMIT=30
# Set actual contracted rates to record an estimated cost. Omitted means unknown, not free.
# AI_INPUT_PRICE_PER_MILLION=0
# AI_OUTPUT_PRICE_PER_MILLION=0
